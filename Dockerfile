# Инструкция сборки образа сервиса записи «Ноготочки».
#
# Node 24: база работает через встроенный модуль node:sqlite, а он перестал
# требовать особый флаг только в 22.13. На node:20 сервис не запустится.
# Версия та же, что и на машине разработки, — она записана в .nvmrc.
#
# Вариант slim, а не alpine: alpine собран на musl, и хотя зависимостей у
# проекта нет вообще, встроенный SQLite там ведёт себя иначе при работе с
# файловыми блокировками — а на них держится защита от двойной записи.
FROM node:24-slim

# Часовой пояс контейнера. Время в базе хранится в UTC, но сообщения в логе
# и расчёт «сегодня» читает человек, и читает он их по студии.
ENV TZ=Europe/Moscow

WORKDIR /app

# Зависимостей у проекта нет — ни одной, ни в dependencies, ни в dev.
# Поэтому здесь нет ни npm ci, ни npm install: ставить нечего, и это
# не упущение, а свойство проекта. Манифест копируется ради имени, версии
# и списка команд.
COPY server/package.json ./server/package.json

# Код приложения и страницы клиента. Всё, что копировать не нужно,
# перечислено в .dockerignore — в первую очередь локальная база и .env.
COPY server ./server
COPY web ./web

# Отдельная папка под базу — к ней на сервере подключается том. Внутри неё
# не должно быть ничего, кроме самой базы: подключается папка целиком, и всё
# лежащее рядом было бы затёрто.
#
# Путь дословно, он понадобится при настройке тома: /app/storage
RUN mkdir -p /app/storage
ENV SQLITE_PATH=/app/storage/varvara.db

# Сервис запускается не от root: если приложение когда-нибудь пробьют,
# у процесса не должно быть прав на весь контейнер. Пользователь node уже
# есть в образе, папку с базой отдаём ему.
RUN chown -R node:node /app/storage
USER node

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

# Проверка живости: Docker и панель по ней понимают, что контейнер не просто
# запущен, а отвечает. Адрес /api/health отдаёт ok без обращения к базе.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Миграции применяет само приложение при запуске — отдельной команды здесь нет
# намеренно: на сервере её некому набирать. См. server/src/index.js.
WORKDIR /app/server
CMD ["node", "src/index.js"]
