# Подключение к базе — заполните ОДИН из двух вариантов.
# Файл .env в репозиторий не попадает, он в .gitignore.

# Вариант 1: одной строкой.
# Спецсимволы в пароле нужно кодировать процентами:
#   @ -> %40   : -> %3A   / -> %2F   ? -> %3F   # -> %23   % -> %25   [ -> %5B   ] -> %5D
DATABASE_URL=postgresql://varvara_app:пароль@127.0.0.1:5433/varvara

# Вариант 2: по частям. Кодировать ничего не нужно — надёжнее для сложных паролей.
# Если заданы обе формы, используется DATABASE_URL.
# PGUSER=varvara_app
# PGPASSWORD=пароль как есть
# PGHOST=127.0.0.1
# PGPORT=5433
# PGDATABASE=varvara

# Хост пишите как 127.0.0.1, а не localhost: на Windows localhost сначала
# разворачивается в IPv6-адрес ::1, и попытка подключения по нему может
# завершиться ошибкой 10013 (Permission denied) до перехода на IPv4.

# Порт сервера API
PORT=3000
