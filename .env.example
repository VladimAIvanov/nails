# Образец переменных окружения. Скопируйте в .env и подставьте свои значения.
# Файл .env в репозиторий не попадает — он в .gitignore.

# Путь к файлу базы SQLite: относительно корня проекта либо абсолютный.
# Если не задан, используется server/data/nogotochki.db
# В контейнере задан абсолютный /app/storage/nogotochki.db — эта папка
# подключается снаружи томом, иначе база пропадёт при первом же обновлении.
SQLITE_PATH=

# Порт, на котором будет слушать сервер
PORT=

# Порт черновых страниц из папки web (npm run web).
# Их сервер читает и PORT — чтобы знать, куда переправлять запросы к API.
WEB_PORT=

# Режим работы: development или production
NODE_ENV=

# Показывать ли пароли демонстрационных учётных записей при загрузке данных.
# Пусто — не показывать: у каждой записи свой случайный пароль, он нигде
# не сохраняется, и войти под демо-записями нельзя. Так и нужно на сервере:
# мастера там нужны как данные, а не как способ войти.
# true — напечатать таблицу «логин — пароль» один раз, при загрузке.
# Для локального стенда: SEED_SHOW_PASSWORDS=true npm run seed
SEED_SHOW_PASSWORDS=

# Источники, которым разрешены межсайтовые запросы к API, через запятую.
# Пусто — межсайтовые запросы запрещены.
CORS_ORIGINS=

# ── TLS ─────────────────────────────────────────────────────────────────────
# Пути к ключу и сертификату. Если заданы, сервер поднимается по HTTPS сам.
# Если TLS завершает обратный прокси, оставьте пусто и заполните TRUST_PROXY.
TLS_KEY_FILE=
TLS_CERT_FILE=

# В рабочем режиме (NODE_ENV=production) сервер откажется стартовать
# по открытому HTTP: токен сеанса ходит в заголовке и по открытому каналу
# виден любому в той же сети. Осознанный запуск без TLS — true.
ALLOW_INSECURE_HTTP=

# ── Обратный прокси ─────────────────────────────────────────────────────────
# Адреса прокси, которым можно верить, через запятую. Только от них
# принимаются заголовки X-Forwarded-For и X-Forwarded-Proto: иначе их
# подставит кто угодно и обойдёт ограничение частоты по адресу.
# Пусто — не доверять никому и брать адрес соединения.
#
# Запись бывает двух видов: точный адрес (127.0.0.1) и подсеть IPv4
# (172.16.0.0/12). В контейнере нужна именно подсеть: прокси приходит
# с адреса docker-сети, а он меняется при её пересоздании.
# Диапазон зависит от того, как настроен Docker, и его надо посмотреть,
# а не угадать: cat /etc/docker/daemon.json, ключ default-address-pools.
# Обычная установка Docker раздаёт сети из 172.16.0.0/12, а установщик
# Coolify прописывает свой пул и берёт 10.0.0.0/8 — на нашем сервере
# верное значение именно второе.
# Адрес IPv6 указывается целиком, подсети для него не поддерживаются.
#
# Осторожно с 0.0.0.0/0: это «верить любому отправителю заголовка»,
# то есть отказ от защиты, а не удобная настройка.
TRUST_PROXY=

# ── Ограничение частоты ─────────────────────────────────────────────────────
# Счётчики хранятся в базе и переживают перезапуск сервиса.
# 0 отключает ограничение.
RATE_LIMIT_LOGIN=
RATE_LIMIT_LOGIN_WINDOW_MIN=
RATE_LIMIT_SIGNUP=
RATE_LIMIT_SIGNUP_WINDOW_MIN=

# ── Сеансы ──────────────────────────────────────────────────────────────────
# Срок жизни токена в днях; при активности срок продлевается.
# Пусто — 7 дней для клиенток и 1 день для администратора и мастера:
# у сотрудников в руках чужие персональные данные, украденный токен
# не должен работать неделями.
SESSION_TTL_DAYS=
SESSION_TTL_DAYS_STAFF=


# ── Вход через Яндекс ────────────────────────────────────────────────────────
# Приложение регистрируется на oauth.yandex.ru, тип — «для авторизации
# пользователей». Права минимальные: адрес почты, логин, имя и фамилия.
#
# Без всех трёх строк вход считается ненастроенным: сервер отвечает отказом,
# а кнопка на странице входа не рисуется вовсе.

# Идентификатор приложения. Не секрет: он открыто уходит в адресную строку,
# когда человек переходит к Яндексу. Он только называет, но ничего не открывает.
YANDEX_CLIENT_ID=

# Секрет приложения — та строка, которую знаете только вы и Яндекс. По ней
# Яндекс узнаёт, что за токеном пришёл именно ваш сервис, а не тот, кто
# подсмотрел идентификатор в адресной строке.
#
# СЕКРЕТ. Задавайте его в панели развёртывания, а не здесь и тем более
# не в файлах проекта. Секрет, попавший в репозиторий хотя бы одним коммитом,
# считается скомпрометированным: история хранит всё, и чистка её не спасает.
# Выход один — выпустить в кабинете новый, старый погасить.
YANDEX_CLIENT_SECRET=

# Адрес возврата. Яндекс сверяет его посимвольно: протокол, домен, путь
# и косую черту в конце. При несовпадении он не ругается, а молча уводит
# человека по первому адресу из списка в кабинете — и разбираться вы будете
# в своём коде, где всё в порядке.
#
# Строка должна совпадать с записанной в кабинете буква в букву, например:
# https://nogotochki.example/api/auth/yandex/callback
YANDEX_REDIRECT_URI=


# ── Первый администратор ─────────────────────────────────────────────────────
# На чистой базе войти в панель студии некем. Эти две переменные заводят
# администратора при запуске — задаются вместе, иначе не сработают.
#
# Зачем не сиды: они кладут демо-услуги, мастеров и записи, а пароль у них
# один на всех и напечатан в README. На опубликованном сервисе это открытая
# дверь, а не удобство.
#
# Существующего пользователя эти переменные НЕ трогают: пароль живого
# администратора не перезаписывается при каждом развёртывании. Сменить его
# можно, войдя под ним, на странице смены пароля.
#
# ADMIN_PASSWORD — секрет: задавайте его в панели развёртывания, а не здесь
# и тем более не в файлах проекта. Минимум 10 знаков. Нигде не печатается.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
