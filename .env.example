# Образец переменных окружения. Скопируйте в .env и подставьте свои значения.
# Файл .env в репозиторий не попадает — он в .gitignore.

# Путь к файлу базы SQLite: относительно корня проекта либо абсолютный.
# Если не задан, используется server/data/varvara.db
# В контейнере задан абсолютный /app/storage/varvara.db — эта папка
# подключается снаружи томом, иначе база пропадёт при первом же обновлении.
SQLITE_PATH=

# Порт, на котором будет слушать сервер
PORT=

# Порт черновых страниц из папки web (npm run web).
# Их сервер читает и PORT — чтобы знать, куда переправлять запросы к API.
WEB_PORT=

# Режим работы: development или production
NODE_ENV=

# Пароль демонстрационных учётных записей для локального стенда.
# На сервере задайте своё значение или не запускайте seed вовсе.
SEED_PASSWORD=

# Источники, которым разрешены межсайтовые запросы к API, через запятую.
# Пусто — межсайтовые запросы запрещены.
CORS_ORIGINS=

# ── TLS ─────────────────────────────────────────────────────────────────────
# Пути к ключу и сертификату. Если заданы, сервер поднимается по HTTPS сам.
# Если TLS завершает обратный прокси, оставьте пусто и заполните TRUST_PROXY.
TLS_KEY_FILE=
TLS_CERT_FILE=

# В рабочем режиме (NODE_ENV=production) сервер откажется стартовать
# по открытому HTTP: токен сеанса ходит в заголовке и по открытому каналу
# виден любому в той же сети. Осознанный запуск без TLS — true.
ALLOW_INSECURE_HTTP=

# ── Обратный прокси ─────────────────────────────────────────────────────────
# Адреса прокси, которым можно верить, через запятую. Только от них
# принимаются заголовки X-Forwarded-For и X-Forwarded-Proto: иначе их
# подставит кто угодно и обойдёт ограничение частоты по адресу.
# Пусто — не доверять никому и брать адрес соединения.
#
# Запись бывает двух видов: точный адрес (127.0.0.1) и подсеть IPv4
# (172.16.0.0/12). В контейнере нужна именно подсеть: прокси приходит
# с адреса docker-сети, а он меняется при её пересоздании.
# Диапазон зависит от того, как настроен Docker, и его надо посмотреть,
# а не угадать: cat /etc/docker/daemon.json, ключ default-address-pools.
# Обычная установка Docker раздаёт сети из 172.16.0.0/12, а установщик
# Coolify прописывает свой пул и берёт 10.0.0.0/8 — на нашем сервере
# верное значение именно второе.
# Адрес IPv6 указывается целиком, подсети для него не поддерживаются.
#
# Осторожно с 0.0.0.0/0: это «верить любому отправителю заголовка»,
# то есть отказ от защиты, а не удобная настройка.
TRUST_PROXY=

# ── Ограничение частоты ─────────────────────────────────────────────────────
# Счётчики хранятся в базе и переживают перезапуск сервиса.
# 0 отключает ограничение.
RATE_LIMIT_LOGIN=
RATE_LIMIT_LOGIN_WINDOW_MIN=
RATE_LIMIT_SIGNUP=
RATE_LIMIT_SIGNUP_WINDOW_MIN=

# ── Сеансы ──────────────────────────────────────────────────────────────────
# Срок жизни токена в днях; при активности срок продлевается.
# Пусто — 7 дней для клиенток и 1 день для администратора и мастера:
# у сотрудников в руках чужие персональные данные, украденный токен
# не должен работать неделями.
SESSION_TTL_DAYS=
SESSION_TTL_DAYS_STAFF=


# ── Вход через Яндекс ────────────────────────────────────────────────────────
# ВРЕМЕННОЕ РЕШЕНИЕ. Заглушка вместо настоящего Яндекса: сервис не обращается
# наружу, а берёт почту и имя прямо отсюда и пускает под ними в кабинет.
#
# Пароль при этом не спрашивается ни разу. Любой, кто откроет сервис, войдёт
# одним нажатием — поэтому НА СЕРВЕРЕ ЭТО ВКЛЮЧАТЬ НЕЛЬЗЯ. Только локальный
# стенд, только на время проверки.
#
# По умолчанию выключено: пустое значение и любое значение кроме true — это
# «выключено». Настоящее приложение Яндекса регистрируется после публикации,
# когда у сервиса появится постоянный адрес возврата.
YANDEX_LOGIN_STUB=

# Кого подставлять, пока заглушка включена. Почта — она же ключ поиска:
# если такая уже есть в базе, вход привяжется к существующему кабинету.
YANDEX_STUB_EMAIL=
YANDEX_STUB_NAME=
