{
  "name": "varvara-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "migrate": "node --env-file-if-exists=../.env src/migrate.js",
    "seed": "node --env-file-if-exists=../.env src/seed.js",
    "reset": "node --env-file-if-exists=../.env src/reset.js",
    "doctor": "node --env-file-if-exists=../.env src/doctor.js",
    "start": "node --env-file-if-exists=../.env src/index.js",
    "dev": "node --env-file-if-exists=../.env --watch src/index.js"
  }
}
