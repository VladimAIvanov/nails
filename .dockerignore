# Что НЕ копировать в образ. Работает как .gitignore, только для сборки.
#
# Правило простое: в образ едет то, без чего приложение не запустится.
# Всё остальное — лишний вес и лишний риск.

# ── Самое важное: локальная база ───────────────────────────────────────────
# Если она уедет в образ, то на сервере ляжет поверх настоящей и затрёт
# записи клиентов. Произойдёт это при обычном обновлении, без единой ошибки
# в логе. Папка целиком, а не только файл: рядом с базой WAL держит
# varvara.db-wal и varvara.db-shm, и они точно так же перезаписали бы чужие.
server/data/
storage/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── Секреты ────────────────────────────────────────────────────────────────
# Пароли и ключи задаются на сервере переменными окружения, а не файлом
# внутри образа: образ можно выгрузить и прочитать. Шаблон .env.example
# исключением ниже оставлен — в нём пустые строки, зато по нему видно,
# какие настройки вообще существуют.
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# ── Зависимости ────────────────────────────────────────────────────────────
# У проекта их нет, но правило оставлено намеренно: если когда-нибудь
# появятся, собранные под Windows в образ на Linux не годятся.
node_modules/
npm-debug.log*

# ── История и служебное ────────────────────────────────────────────────────
.git/
.gitignore
.github/
.claude/
.vscode/
.idea/

# ── Не нужно работающему приложению ────────────────────────────────────────
# Прототип — артефакт проектирования, кодом не используется.
site/
docs/
archive-*/
*.docx
*.md
!README.md

# ── Сам Docker ─────────────────────────────────────────────────────────────
Dockerfile
.dockerignore
docker-compose*.yml
docker-compose*.yaml

# ── Локальное ──────────────────────────────────────────────────────────────
security-review.local.md
*.log
.DS_Store
Thumbs.db
